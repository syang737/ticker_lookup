# Copy to .env and fill in. A real environment variable beats this file.

# The one shared password for the web page. Required.
APP_PASSWORD=

# Signs the session cookie. Without it, everyone is signed out on restart.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required. Starter plan or above (grouped daily aggregates).
MASSIVE_API_KEY=

# Optional but worth it: 100 identifiers per request instead of 10.
# Free at https://www.openfigi.com/api
OPENFIGI_API_KEY=

# true once served over HTTPS, so the cookie is never sent in the clear.
SECURE_COOKIE=false

# Where OpenFIGI answers are cached between runs.
CACHE_PATH=./data/figi_cache.sqlite
